# Backend services
NODE_ENV=development
API_GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4101
PROFILE_SERVICE_PORT=4102
GOALS_SERVICE_PORT=4103
CHECKINS_SERVICE_PORT=4104
PREFERENCES_SERVICE_PORT=4105
SUBSCRIPTIONS_SERVICE_PORT=4106
NOTIFICATIONS_SERVICE_PORT=4107
ANALYTICS_SERVICE_PORT=4108

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=planora

# Redis / Event bus
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
EVENT_BUS_CHANNEL=planora.events

# Auth
JWT_ACCESS_SECRET=replace-with-long-secret
JWT_REFRESH_SECRET=replace-with-another-long-secret

# Mobile gateway base URL (used in mobile env)
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

